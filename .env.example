# Gemini AI API Key (Opsiyonel - AI analizi için gerekli)
# https://makersuite.google.com/app/apikey adresinden alabilirsiniz
GEMINI_API_KEY=your_gemini_api_key_here

# Veritabanı yolu (Opsiyonel - varsayılan: borsa_asistani.db)
# DB_PATH=borsa_asistani.db

# Log seviyesi (Opsiyonel - varsayılan: INFO)
# LOG_LEVEL=INFO

# API Server Port (Opsiyonel - varsayılan: 8000)
# API_PORT=8080

# E-posta Bildirimleri (Opsiyonel)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=your_email@gmail.com
# EMAIL_TO=recipient@gmail.com

# Telegram Bildirimleri (Opsiyonel)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Scheduler Ayarları (Opsiyonel)
# ALERT_INTERVAL_MINUTES=60
# DAILY_REPORT_TIME=09:00
# ENABLE_ALERTS=true
# ENABLE_DAILY_REPORT=true
