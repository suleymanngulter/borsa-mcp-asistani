# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf
*.pyw text eol=lf

# Markdown files
*.md text eol=lf

# Config files
*.ini text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Shell scripts
*.sh text eol=lf

# Git ignore files
.gitignore text eol=lf
.gitattributes text eol=lf
